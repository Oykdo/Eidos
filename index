/* ─────────── transaction : sérialisation et signature ─────────── */
const u32 = n => new Uint8Array([n>>>24&255, n>>>16&255, n>>>8&255, n&255]);
const u64 = v => { const o=new Uint8Array(8); let x=BigInt(v);
  for(let i=7;i>=0;i--){ o[i]=Number(x & 255n); x >>= 8n; } return o; };

function corpsTx(entrees, sorties){
  const p = [u32(1), u16(entrees.length)];
  for (const e of entrees) p.push(e.txid, u32(e.rang));
  p.push(u16(sorties.length));
  for (const s of sorties) p.push(s.adresse, u64(s.montant));
  return cat(...p);
}

async function signerLamport(graine, msg32){
  const pkp = [], skp = [];
  for (let i=0;i<256;i++){
    const a = await sha(cat(graine, enc.encode("sk0"), u16(i)));
    const b = await sha(cat(graine, enc.encode("sk1"), u16(i)));
    skp.push([a,b]); pkp.push(await sha(a), await sha(b));
  }
  const n = BigInt("0x" + hex(msg32));
  const s = [];
  for (let i=0;i<256;i++) s.push(skp[i][Number((n >> BigInt(255-i)) & 1n)]);
  return { pk: cat(...pkp), sig: cat(...s) };
}

async function construireTx(entrees, sorties, graines){
  const c = corpsTx(entrees, sorties);
  const id = await shad(c);
  const p = [u32(c.length), c, u16(entrees.length)];
  for (let i=0;i<entrees.length;i++){
    const t = await signerLamport(graines[i], await sha(cat(id, u32(i))));
    p.push(new Uint8Array([1]), t.pk, t.sig);
  }
  return { txid: hex(id), brut: cat(...p) };
}

function decoderAdresse(saisie){
  const cs = saisie.trim().split(/\s+/).filter(g => g !== "|").map(g => {
    const f = [...g];
    if (f.length !== 3) throw new Error("Ce n'est pas une adresse Eidos.");
    let c = 0;
    for (const ch of f){
      if (!(ch in INV)) throw new Error("Ce n'est pas une adresse Eidos.");
      c = (c << 2) | INV[ch];
    }
    return c;
  });
  if (cs.length !== 31) throw new Error(`${cs.length} symboles au lieu de 31.`);
  const a20 = octets(cs.slice(0,27), 20);
  return { a20, ctrl: octets(cs.slice(27), 3) };
}

$("envoyer").addEventListener("click", async e => {
  const v = $("verdictEnvoi");
  e.target.disabled = true; e.target.textContent = "Signature…";
  try{
    if (!etatReseau || !etatReseau.sorties)
      throw new Error("Le réseau ne publie pas encore les sorties.");
    const { a20, ctrl } = decoderAdresse($("dest").value);
    if (hex(ctrl) !== hex((await shad(a20)).slice(0,3)))
      throw new Error("Adresse altérée — vérifiez-la.");
    const m = Math.round(parseFloat($("montant").value.replace(",", ".")) * 1e8);
    if (!(m > 0)) throw new Error("Montant invalide.");

    // une sortie de ce portefeuille, assez garnie
    let choisie = null;
    for (const a of listeAdresses){
      for (const [ref, o] of Object.entries(etatReseau.sorties)){
        if (o.adresse === a.hexa && o.montant >= m){ choisie = { ref, o, a }; break; }
      }
      if (choisie) break;
    }
    if (!choisie) throw new Error("Aucune sortie assez garnie. Une transaction "
      + "dépense une sortie entière, pas un solde cumulé.");

    // adresse de rendu, neuve
    coffre.n += 1;
    await enregistrer(coffre, motDePasse);
    const maitre = deHex(coffre.maitre);
    const gRendu = await graineAdresse(maitre, coffre.n - 1);
    const aRendu = await adresseDepuis(gRendu);

    const [idHex, rang] = choisie.ref.split(":");
    const sorties = [{ adresse: a20, montant: m }];
    if (choisie.o.montant - m > 0)
      sorties.push({ adresse: aRendu, montant: choisie.o.montant - m });

    const graine = await graineAdresse(maitre, choisie.a.i);
    const tx = await construireTx(
      [{ txid: deHex(idHex), rang: parseInt(rang, 10) }], sorties, [graine]);

    const b64 = btoa(String.fromCharCode(...tx.brut));
    const corps = "Transaction signee, reseau d'essai.\n\n"
      + "-----EIDOS-----\n" + b64 + "\n-----FIN-----\n";
    const url = "https://github.com/Oykdo/Eidos/issues/new"
      + "?title=" + encodeURIComponent("envoi")
      + "&labels=envoi&body=" + encodeURIComponent(corps);
    v.innerHTML = `<span class="ok">Transaction signée.</span> `
      + `${(m/1e8).toFixed(6)} aiôns · ${tx.txid.slice(0,16)}…`;
    $("aideEnvoi").textContent = "Validez l'issue qui vient de s'ouvrir. "
      + "L'envoi sera inclus au bloc suivant.";
    await construireListe();
    window.open(url, "_blank", "noopener");
  } catch(err){
    v.innerHTML = `<span class="ko">${err.message}</span>`;
  }
  e.target.disabled = false; e.target.textContent = "Préparer l'envoi";
});

