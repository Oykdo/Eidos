      if (f.length !== 3) throw new Error("Ce n'est pas une adresse Eidos.");
      let c = 0;
      for (const ch of f){
        if (!(ch in INV)) throw new Error("Ce n'est pas une adresse Eidos.");
        c = (c << 2) | INV[ch];
      }
      return c;
    });
    if (cs.length !== 31)
      throw new Error(`Adresse incomplète : ${cs.length} symboles au lieu de 31.`);
    const a20 = octets(cs.slice(0,27), 20), ctrl = octets(cs.slice(27), 3);
    if (hex(ctrl) !== hex((await shad(a20)).slice(0,3))){
      v.innerHTML = `<span class="ko">Adresse altérée — ne l'utilisez pas.</span>`;
