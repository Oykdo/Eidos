<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#12151A">
<meta name="description" content="Portefeuille Eidos : créez, conservez et vérifiez vos adresses.">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Eidos">
<title>Eidos</title>

<link rel="manifest" href="manifest.webmanifest">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' fill='%2312151A'/%3E%3Cg fill='none' stroke-width='4' stroke-linecap='round'%3E%3Ccircle cx='32' cy='16' r='7.5' stroke='%23C9A227'/%3E%3Cpath d='M24.5 32a7.5 7.5 0 0 0 15 0' stroke='%23C6CBD1'/%3E%3Cpath d='M32 40.5v15M24.5 48h15' stroke='%233A6EA5'/%3E%3C/g%3E%3C/svg%3E">
<link rel="icon" type="image/png" sizes="192x192" href="icone-192.png">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300&family=IBM+Plex+Mono:wght@300;400&display=swap" rel="stylesheet">

<style>
:root{
  --or:#C9A227; --argent:#C6CBD1; --etain:#3A6EA5;
  --fer:#A8332A; --cuivre:#3E8E6E; --vif:#7C5CBF; --plomb:#6E7581;
  --fond:#12151A; --carte:#1A1E25; --encre:#DDE1E6; --sourd:#79818E;
  --trait:rgba(198,203,209,.10);
}
*{box-sizing:border-box}
html,body{margin:0;background:var(--fond);color:var(--encre);
  font-family:"IBM Plex Mono",ui-monospace,monospace;font-size:14.5px;line-height:1.6;
  -webkit-text-size-adjust:100%}
body{padding:max(20px,env(safe-area-inset-top)) 18px
     calc(32px + env(safe-area-inset-bottom))}
main{max-width:560px;margin:0 auto}

header{text-align:center;padding:22px 0 26px;position:relative}
h1{font-family:"Cormorant Garamond",Georgia,serif;font-weight:300;font-size:30px;
  letter-spacing:.42em;text-transform:uppercase;margin:0 0 10px;padding-left:.42em}
.sous{font-size:12px;color:var(--sourd)}
#verrouiller{position:absolute;right:0;top:24px;width:auto;padding:8px 12px;
  font-size:11px;background:transparent;color:var(--sourd);
  border:1px solid var(--trait)}

section{background:var(--carte);border:1px solid var(--trait);border-radius:4px;
  padding:22px 18px;margin-bottom:16px}
h2{font-size:16px;font-weight:400;margin:0 0 6px}
.aide{font-size:12.5px;color:var(--sourd);margin:0 0 18px}

button{font-family:inherit;font-size:14px;cursor:pointer;width:100%;
  background:var(--or);color:#12151A;border:0;padding:15px;border-radius:3px;
  -webkit-tap-highlight-color:transparent;margin-top:4px}
button.discret{background:transparent;color:var(--encre);
  border:1px solid rgba(198,203,209,.24);font-size:13px;padding:12px}
button.danger{background:transparent;color:var(--fer);
  border:1px solid rgba(168,51,42,.4);font-size:12px;padding:11px}
button[disabled]{opacity:.45}
:focus-visible{outline:2px solid var(--or);outline-offset:3px}

input,textarea{font-family:inherit;font-size:16px;width:100%;background:#0E1116;
  color:var(--encre);border:1px solid var(--trait);border-radius:3px;
  padding:13px;margin-bottom:10px}
textarea{min-height:92px;resize:vertical;line-height:2;font-size:15px}
label{display:block;font-size:11px;letter-spacing:.12em;text-transform:uppercase;
  color:var(--sourd);margin:0 0 7px}

.cadre{background:#0E1116;border:1px solid var(--trait);border-radius:3px;
  padding:14px 10px;margin:14px 0 12px;overflow-x:auto}
.cadre svg{display:block;margin:0 auto}

.ligne{display:flex;justify-content:space-between;gap:12px;padding:9px 0;
  border-bottom:1px solid var(--trait);font-size:13.5px}
.ligne:last-child{border-bottom:0}
.ligne .k{color:var(--sourd)}
.ligne .v{font-variant-numeric:tabular-nums;text-align:right}

.total{font-size:26px;font-variant-numeric:tabular-nums;text-align:center;
  padding:6px 0 2px;color:var(--or)}
.totalh{text-align:center;font-size:11px;letter-spacing:.14em;
  text-transform:uppercase;color:var(--sourd);margin-bottom:18px}

.adr{border:1px solid var(--trait);border-radius:3px;padding:12px;margin-bottom:10px}
.adr .haut{display:flex;justify-content:space-between;font-size:12px;
  color:var(--sourd);margin-bottom:8px}
.adr .solde{color:var(--encre);font-variant-numeric:tabular-nums}
.adr.vide .solde{color:var(--sourd)}
.sym{font-size:13px;line-height:1.75;word-break:break-all;color:var(--argent)}

.alerte{border-left:2px solid var(--fer);padding:13px 0 13px 14px;margin-top:18px;
  font-size:12.5px;color:var(--sourd);line-height:1.7}
.alerte b{color:var(--or)}
.mots{font-size:12.5px;word-break:break-all;color:var(--argent);line-height:1.9;
  background:#0E1116;padding:12px;border-radius:3px;margin:10px 0}

.verdict{margin-top:12px;font-size:14px;min-height:20px}
.ok{color:var(--cuivre)} .ko{color:var(--fer)}

details{margin-top:6px;border-top:1px solid var(--trait);padding-top:15px}
summary{font-size:13px;color:var(--sourd);cursor:pointer;list-style:none}
summary::-webkit-details-marker{display:none}
summary::before{content:"+ ";color:var(--or)}
details[open] summary::before{content:"− "}
details p{font-size:12.5px;color:var(--sourd)}

footer{color:var(--sourd);font-size:11px;text-align:center;padding:22px 0 4px;
  line-height:1.9}
footer a{color:var(--sourd)}
.masque{display:none}
</style>
</head>
<body>
<main>

<header>
  <h1>Eidos</h1>
  <div class="sous">Réseau d'essai — sans valeur monétaire</div>
  <button id="verrouiller" class="masque">Verrouiller</button>
</header>

<!-- ── aucun portefeuille ─────────────────────────────────────────── -->
<section id="vueCreation" class="masque">
  <h2>Créer un portefeuille</h2>
  <p class="aide">Choisissez un mot de passe. Il chiffre votre portefeuille sur
    cet appareil, et lui seul permet de le rouvrir.</p>
  <label for="mdp1">Mot de passe</label>
  <input id="mdp1" type="password" autocomplete="new-password">
  <label for="mdp2">Répétez-le</label>
  <input id="mdp2" type="password" autocomplete="new-password">
  <div class="verdict" id="verdictCreation"></div>
  <button id="creerPortefeuille">Créer</button>
  <div class="alerte">
    <b>Personne ne peut réinitialiser ce mot de passe.</b> Il n'est envoyé nulle
    part et n'existe qu'entre vos mains. Perdu, le portefeuille l'est aussi —
    sauf si vous avez noté le code de secours affiché juste après.
  </div>
</section>

<!-- ── portefeuille verrouillé ────────────────────────────────────── -->
<section id="vueVerrou" class="masque">
  <h2>Déverrouiller</h2>
  <p class="aide">Votre portefeuille est chiffré sur cet appareil.</p>
  <label for="mdp">Mot de passe</label>
  <input id="mdp" type="password" autocomplete="current-password">
  <div class="verdict" id="verdictVerrou"></div>
  <button id="deverrouiller">Ouvrir</button>
  <details style="margin-top:20px">
    <summary>J'ai oublié mon mot de passe</summary>
    <p>Il ne peut pas être récupéré. Si vous avez noté le code de secours,
      effacez ce portefeuille et restaurez-le à partir du code. Sinon, les
      adresses qu'il contenait sont définitivement inaccessibles.</p>
    <button id="effacer" class="danger">Effacer ce portefeuille</button>
  </details>
</section>

<!-- ── code de secours, montré une seule fois ─────────────────────── -->
<section id="vueSecours" class="masque">
  <h2>Votre code de secours</h2>
  <p class="aide">Recopiez-le sur papier, maintenant. Il ne sera plus jamais
    affiché.</p>
  <div class="mots" id="secours"></div>
  <button class="discret" id="copierSecours">Copier le code</button>
  <div class="alerte">
    Ce code seul permet de retrouver toutes vos adresses si vous perdez cet
    appareil ou votre mot de passe. <b>Ne le photographiez pas, ne l'envoyez
    par aucun message.</b>
  </div>
  <button id="secoursNote" style="margin-top:16px">Je l'ai noté</button>
</section>

<!-- ── portefeuille ouvert ────────────────────────────────────────── -->
<section id="vuePortefeuille" class="masque">
  <div class="total" id="soldeTotal">—</div>
  <div class="totalh">solde total</div>
  <div id="adresses"></div>
  <button id="nouvelleAdresse">Nouvelle adresse pour recevoir</button>
  <p class="aide" style="margin:14px 0 18px">Une adresse ne sert qu'une fois.
    Créez-en une neuve à chaque paiement attendu.</p>
  <button id="robinet" class="discret">Recevoir 1 aiôn du robinet</button>
  <p class="aide" id="aideRobinet" style="margin:10px 0 0">Le réseau d'essai
    distribue des aiôns sans valeur, pour essayer. Un compte GitHub est
    nécessaire.</p>
</section>

<!-- ── envoi ─────────────────────────────────────────────────────── -->
<section id="vueEnvoi" class="masque">
  <h2>Envoyer</h2>
  <p class="aide">Collez l'adresse de votre correspondant, indiquez le montant.
    La transaction est signée sur cet appareil.</p>
  <label for="dest">Adresse du destinataire</label>
  <textarea id="dest" spellcheck="false" autocapitalize="off"
    placeholder="Collez les 31 symboles"></textarea>
  <label for="montant">Montant en aiôns</label>
  <input id="montant" type="text" inputmode="decimal" placeholder="0.400000">
  <div class="verdict" id="verdictEnvoi"></div>
  <button id="envoyer">Préparer l'envoi</button>
  <p class="aide" id="aideEnvoi" style="margin:12px 0 0">Un compte GitHub est
    nécessaire pour transmettre la transaction au réseau.</p>
</section>

<!-- ── vérification ───────────────────────────────────────────────── -->
<section>
  <h2>Vérifier une adresse</h2>
  <p class="aide">Collez une adresse reçue pour contrôler qu'elle n'a pas été
    altérée en chemin.</p>
  <textarea id="saisie" spellcheck="false" autocapitalize="off"
    placeholder="Collez l'adresse ici"></textarea>
  <div class="verdict" id="verdict"></div>
</section>

<!-- ── réseau ─────────────────────────────────────────────────────── -->
<section id="reseau">
  <h2>Le réseau</h2>
  <p class="aide" id="reseauAide">Chargement…</p>
  <div id="chiffres"></div>
</section>

<section>
  <details>
    <summary>Où est stocké mon portefeuille ?</summary>
    <p>Uniquement dans ce navigateur, chiffré par votre mot de passe. Rien n'est
      envoyé sur internet : les clés sont calculées sur votre appareil. Effacer
      les données de Safari pour ce site supprimerait le portefeuille — le code
      de secours est votre seule copie.</p>
  </details>
  <details>
    <summary>Puis-je envoyer des fonds ?</summary>
    <p>Pas encore. Le réseau d'essai ne collecte pas les transactions : cette
      page sait créer des adresses, afficher leurs soldes et vérifier une adresse
      reçue. L'envoi viendra avec un point de collecte des transactions.</p>
  </details>
  <details>
    <summary>Pourquoi des symboles plutôt que des lettres ?</summary>
    <p>Une adresse est un très long nombre. Écrite en lettres et chiffres, une
      erreur de copie passe inaperçue. Ici chaque symbole empile trois figures —
      cercle, croissant, croix — et les quatre derniers, en doré, contrôlent
      tous les autres. Si un seul symbole change, la vérification le détecte.</p>
  </details>
  <details>
    <summary>Pourquoi une adresse par paiement ?</summary>
    <p>Le code secret d'une adresse ne peut servir qu'une seule fois. C'est ce
      qui rend Eidos résistant aux futurs ordinateurs quantiques.</p>
  </details>
</section>

<footer>
  <a href="https://github.com/Oykdo/Eidos">github.com/Oykdo/Eidos</a>
</footer>

</main>
<script>
"use strict";

const CLE_STOCKAGE = "eidos-portefeuille-v1";
const ITERATIONS = 310000;
const enc = new TextEncoder();
const $ = id => document.getElementById(id);
const montrer = (...ids) => {
  ["vueCreation","vueVerrou","vueSecours","vuePortefeuille"]
    .forEach(v => $(v).classList.toggle("masque", !ids.includes(v)));
  if (!ids.includes("vuePortefeuille")) $("vueEnvoi").classList.add("masque");
};

/* ─────────── hachage et outils ─────────── */
async function sha(b){ return new Uint8Array(await crypto.subtle.digest("SHA-256", b)); }
async function shad(b){ return sha(await sha(b)); }
function cat(...a){ const n=a.reduce((s,x)=>s+x.length,0), o=new Uint8Array(n);
  let i=0; for(const x of a){ o.set(x,i); i+=x.length; } return o; }
function hex(u){ return [...u].map(b=>b.toString(16).padStart(2,"0")).join(""); }
function deHex(s){ const o=new Uint8Array(s.length/2);
  for(let i=0;i<o.length;i++) o[i]=parseInt(s.substr(i*2,2),16); return o; }
function u16(n){ return new Uint8Array([n>>8&255, n&255]); }
function b64(u){ return btoa(String.fromCharCode(...u)); }
function deB64(s){ return Uint8Array.from(atob(s), c => c.charCodeAt(0)); }

/* ─────────── chiffrement du coffre ─────────── */
async function cleDepuisMotDePasse(mdp, sel){
  const base = await crypto.subtle.importKey("raw", enc.encode(mdp),
    "PBKDF2", false, ["deriveKey"]);
  return crypto.subtle.deriveKey(
    { name:"PBKDF2", salt:sel, iterations:ITERATIONS, hash:"SHA-256" },
    base, { name:"AES-GCM", length:256 }, false, ["encrypt","decrypt"]);
}

async function enregistrer(coffre, mdp){
  const sel = crypto.getRandomValues(new Uint8Array(16));
  const iv  = crypto.getRandomValues(new Uint8Array(12));
  const cle = await cleDepuisMotDePasse(mdp, sel);
  const chiffre = new Uint8Array(await crypto.subtle.encrypt(
    { name:"AES-GCM", iv }, cle, enc.encode(JSON.stringify(coffre))));
  const paquet = { v:1, iterations:ITERATIONS, sel:b64(sel), iv:b64(iv),
                   donnees:b64(chiffre) };
  try{ localStorage.setItem(CLE_STOCKAGE, JSON.stringify(paquet)); }
  catch(e){ throw new Error("Le navigateur refuse d'enregistrer (mode privé ?)"); }
}

async function ouvrir(mdp){
  const paquet = JSON.parse(localStorage.getItem(CLE_STOCKAGE));
  const cle = await cleDepuisMotDePasse(mdp, deB64(paquet.sel));
  const clair = await crypto.subtle.decrypt(
    { name:"AES-GCM", iv:deB64(paquet.iv) }, cle, deB64(paquet.donnees));
  return JSON.parse(new TextDecoder().decode(clair));
}

function coffreExiste(){
  try{ return !!localStorage.getItem(CLE_STOCKAGE); } catch(e){ return false; }
}

/* ─────────── dérivation des adresses ─────────── */
async function graineAdresse(maitre, i){
  return sha(cat(maitre, enc.encode("adr"), u16(i)));
}

async function adresseDepuis(graine){
  const p = [];
  for (let i = 0; i < 256; i++)
    for (const tag of ["sk0","sk1"])
      p.push(await sha(await sha(cat(graine, enc.encode(tag), u16(i)))));
  return (await sha(cat(...p))).slice(0, 20);
}

/* ─────────── codec à trois figures ─────────── */
const FIG = ["\u00b7","\u25cb","\u263d","\u271a"];
const INV = {}; FIG.forEach((f,i)=>INV[f]=i);
const TEINTES = ["#C9A227","#C6CBD1","#A8332A","#7C5CBF","#3A6EA5","#3E8E6E","#6E7581"];

function codes(u){
  let b = [...u].map(x=>x.toString(2).padStart(8,"0")).join("");
  b += "0".repeat((6 - b.length % 6) % 6);
  const c = []; for (let i=0;i<b.length;i+=6) c.push(parseInt(b.slice(i,i+6),2));
  return c;
}
function octets(cs, n){
  const b = cs.map(c=>c.toString(2).padStart(6,"0")).join("").slice(0, n*8);
  const o = new Uint8Array(n);
  for (let i=0;i<n;i++) o[i] = parseInt(b.slice(i*8, i*8+8), 2);
  return o;
}
function texte(u){
  return codes(u).map(c => [0,1,2].map(e => FIG[(c >> (2*(2-e))) & 3]).join("")).join(" ");
}
async function texteComplet(a20){
  return texte(a20) + "  |  " + texte((await shad(a20)).slice(0,3));
}

function dessiner(a20, ctrl){
  const tous = [...codes(a20).map(c=>[c,0]), ...codes(ctrl).map(c=>[c,1])];
  const dispo = Math.min(480, innerWidth - 66);
  const parRangee = Math.max(6, Math.min(9, Math.floor(dispo / 44)));
  const pas = dispo / parRangee, hRang = 80, r = 7.5;
  const H = Math.ceil(tous.length / parRangee) * hRang;
  let s = `<svg viewBox="0 0 ${dispo} ${H}" width="${dispo}" height="${H}" fill="none"
    stroke-width="1.6" stroke-linecap="round" role="img"
    aria-label="adresse en symboles à trois figures">`;
  tous.forEach(([code, ctl], n) => {
    const cx = (n % parRangee) * pas + pas/2;
    const y0 = Math.floor(n / parRangee) * hRang + 14;
    const col = ctl ? "#C9A227" : TEINTES[n % 7];
    for (let e = 0; e < 3; e++){
      const st = (code >> (2*(2-e))) & 3, cy = y0 + e*22;
      if (st === 0) s += `<line x1="${cx-5}" y1="${cy}" x2="${cx+5}" y2="${cy}" stroke="${col}" opacity=".2"/>`;
      else if (st === 1) s += `<circle cx="${cx}" cy="${cy}" r="${r}" stroke="${col}"/>`;
      else if (st === 2) s += `<path d="M ${cx-r} ${cy} A ${r} ${r} 0 0 0 ${cx+r} ${cy}" stroke="${col}"/>`;
      else s += `<path d="M ${cx} ${cy-r} L ${cx} ${cy+r} M ${cx-r} ${cy} L ${cx+r} ${cy}" stroke="${col}"/>`;
    }
  });
  return s + "</svg>";
}

/* ─────────── état en mémoire ─────────── */
let coffre = null;          // { maitre: hex, n: entier }
let motDePasse = null;      // conservé le temps de la session déverrouillée
let listeAdresses = [];     // [{ i, a20, hexa, symboles }]
let etatReseau = null;

function verrouiller(){
  coffre = null; motDePasse = null; listeAdresses = [];
  $("verrouiller").classList.add("masque");
  $("mdp").value = "";
  montrer(coffreExiste() ? "vueVerrou" : "vueCreation");
}

/* ─────────── réseau ─────────── */
function nombre(n){ return n.toLocaleString("fr-FR"); }

async function chargerEtat(){
  try{
    const r = await fetch("etat.json", { cache:"no-store" });
    if (!r.ok) throw 0;
    etatReseau = await r.json();
    const u = etatReseau.atomes_par_unite;
    const part = etatReseau.emission_cumulee_atomes / etatReseau.emission_totale_atomes * 100;
    $("reseauAide").textContent = "Mise à jour : " +
      new Date(etatReseau.maj_unix * 1000).toLocaleString("fr-FR");
    $("chiffres").innerHTML = `
      <div class="ligne"><span class="k">Blocs</span>
        <span class="v">${nombre(etatReseau.hauteur + 1)}</span></div>
      <div class="ligne"><span class="k">En circulation</span>
        <span class="v">${nombre(Math.round(etatReseau.en_circulation_atomes / u))}</span></div>
      <div class="ligne"><span class="k">Récompense du bloc</span>
        <span class="v">${(etatReseau.recompense_courante_atomes / u).toFixed(6)}</span></div>
      <div class="ligne"><span class="k">Âge</span>
        <span class="v">${etatReseau.age}</span></div>
      <div class="ligne"><span class="k">Émis sur le total</span>
        <span class="v">${part.toFixed(4)} %</span></div>`;
  } catch(e){
    $("reseauAide").textContent = "Réseau injoignable pour le moment.";
  }
}

function solde(hexAdresse){
  if (!etatReseau) return null;
  return (etatReseau.soldes[hexAdresse] || 0) / etatReseau.atomes_par_unite;
}

/* ─────────── affichage du portefeuille ─────────── */
async function construireListe(){
  listeAdresses = [];
  const maitre = deHex(coffre.maitre);
  for (let i = 0; i < coffre.n; i++){
    const a20 = await adresseDepuis(await graineAdresse(maitre, i));
    listeAdresses.push({ i, a20, hexa: hex(a20),
                         symboles: await texteComplet(a20) });
  }
}

async function afficherPortefeuille(){
  const boite = $("adresses");
  boite.innerHTML = "";
  let total = 0;
  for (const a of listeAdresses){
    const s = solde(a.hexa);
    if (s !== null) total += s;
    const d = document.createElement("div");
    d.className = "adr" + (s ? "" : " vide");
    d.innerHTML =
      `<div class="haut"><span>adresse ${a.i + 1}</span>
       <span class="solde">${s === null ? "—" : s.toFixed(6)}</span></div>
       <div class="sym">${a.symboles}</div>`;
    const b = document.createElement("button");
    b.className = "discret"; b.textContent = "Copier";
    b.style.marginTop = "10px";
    b.onclick = async () => {
      try{ await navigator.clipboard.writeText(a.symboles);
        b.textContent = "Copié"; setTimeout(()=>b.textContent="Copier", 1500); }
      catch(e){ b.textContent = "Copie refusée"; }
    };
    d.appendChild(b);
    boite.appendChild(d);
  }
  $("soldeTotal").textContent = etatReseau ? total.toFixed(6) : "—";
  montrer("vuePortefeuille");
  $("vueEnvoi").classList.toggle("masque", total <= 0);
  $("verrouiller").classList.remove("masque");
